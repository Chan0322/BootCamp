<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="board">
	<select id="selectAll" resultType="boardDto">
		SELECT *
		FROM TESTBOARD
		ORDER BY TESTNO
	</select>
	
	<select id="selectOne" resultType="boardDto">
		SELECT *
		FROM TESTBOARD
		WHERE TESTNO=#{testno}
	</select>
	
	<update id="update">
		UPDATE TESTBOARD
		SET TESTTITLE=#{testtitle}, TESTCONTENT=#{testcontent}
		WHERE TESTNO=#{testno}
	</update>
	
	<insert id="insert">
		INSERT INTO TESTBOARD
		VALUES(SEQ_TB.NEXTVAL, #{testname}, #{testtitle}, #{testcontent}, SYSDATE, #{memno})
	</insert>
	
	<delete id="delete">
		DELETE FROM TESTBOARD
		WHERE TESTNO=#{testno}
	</delete>
</mapper>