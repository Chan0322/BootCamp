package com.test01;

public class study_oper {

	public static void main(String[] args) {

		// 산술연산자
		int a = 5 + 6;		// 결과 : 11
		int b = 10 - 5;		// 결과 : 5
		int c = 2 * 3;		// 결과 : 6
		int d = 7 / 2;		// 결과 : 3
		int e = 7 % 2;		// 결과 : 1
		System.out.println(a+","+b+","+c+","+d+","+e);
		
		// 직접 접근 연산자
		int f = (5+2)*3;	// 결과 : 30
		System.out.println(f);
	}

}
