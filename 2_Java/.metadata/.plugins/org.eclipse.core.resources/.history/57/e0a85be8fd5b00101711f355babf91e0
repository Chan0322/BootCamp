package com.test02;

public class study {
	public static void main(String[] args) {
		
		// if 예시		결과 : 학생입니다.
		int age = 15;
		if(age<=19) {
			System.out.println("학생입니다.");
		}
	
		// if-else 예시		결과 : 홀수입니다.
		int a = 5;
		if(a%2==0) {
			System.out.println("짝수입니다.");
		}else {
			System.out.println("홀수입니다.");
		}
		
		// 다중 if-else 예시		결과 : C
		int math = 75;
		if(math >= 90) {
			System.out.println("A");
		}else if(math >= 80) {
			System.out.println("B");
		}else if(math >= 70) {
			System.out.println("C");
		}else {
			System.out.println("재시험 대상입니다.");
		}
		
		//중첩 if-else 예시		결과 : 양수인 짝수
		int b = 10;
		if(b>0) {
			if(b%2==0) {
				System.out.println("양수인 짝수");
			}else {
				System.out.println("양수인 홀수");
			}
		}else {
			if(b==0) {
				System.out.println("0입니다.");
			}else {
				System.out.println("음수 입니다.");
			}
		}
		
		// 삼항 연산자 예시		결과 : 홀수
		int c = 11;
		System.out.println((c%2==0)?"짝수":"홀수");
		
		// switch 예시			결과 : 여름
		int season = 2;
		switch(season) {
		case 1:
			System.out.println("봄");
			break;
		case 2:
			System.out.println("여름");
			break;
		case 3:
			System.out.println("가을");
			break;
		case 4:
			System.out.println("겨울");
			break;
		default:
			System.out.println("일치하는 계절이 없습니다.");
			break;
		}
		
		// break가 없다면?
		int systemSetting = 2;
		switch(systemSetting) {
		case 1:
			System.out.println("프로그램을 종료합니다.");
		case 2:
			System.out.println("프로그램을 시작합니다.");
		case 3:
			System.out.println("절전 모드로 전환합니다");
		case 4:
			System.out.println("프로그램을 다시 시작합니다.");
		case 5:
			System.out.println("프로그램을 초기화 합니다.");
		default:
			System.out.println("프로그램 오류 발생!!");
		}
	}
}
