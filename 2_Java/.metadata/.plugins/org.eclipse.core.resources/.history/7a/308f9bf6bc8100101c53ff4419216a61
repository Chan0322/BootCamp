package com.study;


public class Human {
	static void ageArr(int[] arr) {
		arr[0] = 25;	// 같은 배열을 참조하므로 원본도 함께 변경
	}
	
	public static void main(String[] args) {
		int[] ages = {10, 15, 20};
		System.out.println(ages[0]+"/"+ages[1]+"/"+ages[2]);
		// 10/15/20
		ageArr(ages);
		System.out.println(ages[0]+"/"+ages[1]+"/"+ages[2]);
		// 25/15/20
	}
}


