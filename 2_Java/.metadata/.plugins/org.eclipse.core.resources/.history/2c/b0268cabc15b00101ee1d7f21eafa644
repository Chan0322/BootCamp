package com.test02;

public class study {
	public static void main(String[] args) {
		
		// if 예시
		int age = 15;
		if(age<=19) {
			System.out.println("학생입니다.");
		}
	
		// if-else 예시
		int a = 5;
		if(a%2==0) {
			System.out.println("짝수입니다.");
		}else {
			System.out.println("홀수입니다.");
		}
		
		// 다중 if-else 예시
		int math = 75;
		if(math >= 90) {
			System.out.println("A");
		}else if(math >= 80) {
			System.out.println("B");
		}else if(math >= 70) {
			System.out.println("C");
		}else {
			System.out.println("재시험 대상입니다.");
		}
		
	}
}
