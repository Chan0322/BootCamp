package com.silsub1;

import java.util.Arrays;
import java.util.Comparator;
import java.util.List;
import java.util.NoSuchElementException;
import java.util.Set;
import java.util.stream.Collectors;

public class Silsub01 {

	public static void main(String[] args) {
		Trader raoul = new Trader("kim", "Seoul");
		Trader mario = new Trader("lee", "Suwon");
		Trader alan = new Trader("park", "Busan");
		Trader brian = new Trader("choi", "Incheon");
		
		List<Transaction> transactions = Arrays.asList(
	            new Transaction("choi", 2021, 500),
	            new Transaction("kim", 2022, 1200),
	            new Transaction("kim", 2021, 300),
	            new Transaction("lee", 2022, 620),
	            new Transaction("lee", 2022, 810),
	            new Transaction("park", 2022, 990)
	        );
		
		// 1. 2021년에 일어난 모든 트랜잭션을 찾아 값을 오름차순으로 정렬
        List<Transaction> q1 = transactions.stream()
            .filter(t -> t.getYear() == 2021)
            .sorted(Comparator.comparing(Transaction::getValue))
            .collect(Collectors.toList());
        System.out.println("1) 2021년 거래: " + q1);

        // 2. 2022년에 일어난 모든 트랜잭션을 value 기준 오름차순 정렬
        List<Transaction> q2 = transactions.stream()
            .filter(t -> t.getYear() == 2022)
            .sorted(Comparator.comparing(Transaction::getValue))
            .collect(Collectors.toList());
        System.out.println("2) 2022년 거래: " + q2);

        // 3. 거래자가 근무하는 모든 도시를 중복 없이 나열
        Set<String> q3 = transactions.stream()
            .map(t -> t.getTrader().getCity())
            .collect(Collectors.toSet());
        System.out.println("3) 거래 도시: " + q3);

        // 4. 서울에서 근무하는 거래자를 이름순 정렬
        List<Trader> q4 = transactions.stream()
            .map(Transaction::getTrader)
            .filter(tr -> "Seoul".equals(tr.getCity()))
            .distinct()
            .sorted(Comparator.comparing(Trader::getName))
            .collect(Collectors.toList());
        System.out.println("4) 서울 거래자: " + q4);

        // 5. 모든 거래자의 이름을 알파벳 순으로 정렬해서 반환
        List<String> q5 = transactions.stream()
            .map(t -> t.getTrader().getName())
            .distinct()
            .sorted()
            .collect(Collectors.toList());
        System.out.println("5) 거래자 이름 알파벳 순: " + q5);

        // 6. 인천에 거래자가 있는가?
        boolean q6 = transactions.stream()
            .map(Transaction::getTrader)
            .anyMatch(tr -> "Incheon".equals(tr.getCity()));
        System.out.println("6) 인천 거래자 존재? " + q6);

        // 7. 수원에 거주하는 거래자의 모든 트랜잭션 값 출력
        List<Integer> q7 = transactions.stream()
            .filter(t -> "Suwon".equals(t.getTrader().getCity()))
            .map(Transaction::getValue)
            .collect(Collectors.toList());
        System.out.println("7) 수원 거래 값: " + q7);

        // 8. 전체 트랜잭션 중 필드 value의 최댓값
        int q8 = transactions.stream()
            .mapToInt(Transaction::getValue)
            .max()
            .orElseThrow(() -> new NoSuchElementException("트랜잭션 없음"));
        System.out.println("8) 최대 거래 금액: " + q8);
    }

	}

}
