	public int getLastBookNo() {
		int lastNo = 0;
		Iterator<String> lNo = bookMap.keySet().iterator();
		while(lNo.hasNext()){
			int no = Integer.parseInt(lNo.next());
			if(no > lastNo) {
				lastNo = no;
			}
		}
		return lastNo;
	}
	
