package com.lv9;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileNotFoundException;
import java.io.IOException;
import java.io.StringReader;
import java.nio.channels.ReadableByteChannel;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.Scanner;

public class aaaaa {

	public static void main(String[] args) throws IOException {
	
		// Scanner 생성자 예
		
		// Scanner(InputStream s)
		Scanner sc1 = new Scanner(System.in);
		System.out.println("현재 계절 입력: ");
		String season = sc1.nextLine();
		System.out.println("현재 계절은 " + season + "입니다!");
		// 입력: 여름 => 출력: 현재 계절은 여름입니다!
		
		// Scanner(File s)
		File file = new File("test.txt");
		Scanner sc2 = new Scanner(file);
		while(sc2.hasNextLine()) {
			System.out.println(sc2.nextLine());
		}
		// 파일 내용 : Hello
		//			Java!
		// 출력 내용 : Hello
		//			Java!
		
		//3. Scanner(String source)
		String input = "안녕하세요 홍길동 입니다.";
		Scanner sc3 = new Scanner(input);
		while (sc3.hasNext()) {
		    System.out.println(sc3.next());
		}


		// Scanner(Readable s)
		StringReader reader = new StringReader("가 나 다");
		Scanner sc4 = new Scanner(reader);
		while(sc4.hasNext()) {
			System.out.println(sc4.next());
		}

		
		// Scanner(Path s)
		Path p = Paths.get("test.txt");
		Scanner sc5 = new Scanner(p);
		while(sc5.hasNextLine()) {
			System.out.println(sc5.nextLine());
		}
		
		//Scanner(ReadableByteChannel s)
		ReadableByteChannel ch = new FileInputStream("test.txt").getChannel();
		Scanner sc6 = new Scanner(ch);
		while(sc6.hasNextLine()) {
			System.out.println(sc6.nextLine());
		}
		ch.close();
	}

}
