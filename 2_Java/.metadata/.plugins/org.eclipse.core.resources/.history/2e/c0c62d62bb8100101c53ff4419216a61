package com.study;

class Person{
	int age;
}

public class Human {
	static void humanAge(Person p) {
		p.age = 25;	// 같은 객체를 참조 => 원본 값도 변경
	}
	
	public static void main(String[] args) {
		Person p2 = new Person();
		p2.age = 15;
		humanAge(p2);
		System.out.println(p2.age);
	}
}


