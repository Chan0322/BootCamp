package com.lv13;

import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.IOException;
import java.io.InputStreamReader;
import java.io.OutputStreamWriter;
import java.util.StringTokenizer;

public class lv13_10_age {

	public static void main(String[] args) throws NumberFormatException, IOException {
		age();
	}

	public static void age() throws NumberFormatException, IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));

		int n = Integer.parseInt(br.readLine());

		// 회원 나이와 이름 저장
		String[][] person = new String[n][2];
		for (int i = 0; i < n; i++) {
			StringTokenizer st = new StringTokenizer(br.readLine());
			person[i][0] = st.nextToken(); // 나이
			person[i][1] = st.nextToken(); // 이름
		}

		// 정렬
		for (int i = 0; i < n - 1; i++) {
			for (int j = i + 1; j < n; j++) {
				// 나이순 정렬
				if (Integer.parseInt(person[i][0]) == Integer.parseInt(person[j][0])) {
					continue;
				}

				if (Integer.parseInt(person[i][0]) > Integer.parseInt(person[j][0])) {
					String ageTmp = person[i][0];
					String nameTmp = person[i][1];

					person[i][0] = person[j][0];
					person[i][1] = person[j][1];
					person[j][0] = ageTmp;
					person[j][1] = nameTmp;
				}
			}
		}

		for (int i = 0; i < n; i++) {
			bw.write(person[i][0] + " " + person[i][1] + "\n");
		}

		bw.close();
		br.close();
	}
}
