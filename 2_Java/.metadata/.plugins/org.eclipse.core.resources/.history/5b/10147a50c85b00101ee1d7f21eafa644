package com.test02;

public class study {
	public static void main(String[] args) {
		
		// if 예시
		int age = 15;
		if(age<=19) {
			System.out.println("학생입니다.");
		}
	
		// if-else 예시
		int a = 5;
		if(a%2==0) {
			System.out.println("짝수입니다.");
		}else {
			System.out.println("홀수입니다.");
		}
		
		// 다중 if-else 예시
		int math = 75;
		if(math >= 90) {
			System.out.println("A");
		}else if(math >= 80) {
			System.out.println("B");
		}else if(math >= 70) {
			System.out.println("C");
		}else {
			System.out.println("재시험 대상입니다.");
		}
		
		//중첩 if-else 예시
		int b = 10;
		if(b>0) {
			if(b%2==0) {
				System.out.println("양수인 짝수");
			}else {
				System.out.println("양수인 홀수");
			}
		}else {
			if(b==0) {
				System.out.println("0입니다.");
			}else {
				System.out.println("음수 입니다.");
			}
		}
		
		// 삼항 연산자 예시ㅣ
		int c = 11;
		System.out.println((c%2==0)?"짝수":"홀수");
	}
}
