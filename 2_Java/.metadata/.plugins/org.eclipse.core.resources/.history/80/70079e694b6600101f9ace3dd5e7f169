package com.test01;

import java.util.Arrays;

public class studyArray {

	public static void main(String[] args) {
		
		// 배열 선언 (메모리 할당 전)
		int[] numbers;
		String[] people;
		
		// 선언 크기 지정
		int[] ages = new int[5];
		String[] names = new String[6];
		
		// 선언 및 초기화
		int price[] = {3000, 5000, 7000, 10000, 50000};
		String cars[] = {"Avante", "Sonate", "Grandeur", "Genesis"};
		
		// 만약 배열 선언과 초기화를 분리시키고 싶을 경우 아래와 같이 작성 => 초기화시 반드시 new 타입명[] 작성해야 함!
		String[] cars2;
		cars2 = new String[] {"k3", "k5", "k7", "k8", "k9"};
		
		
	//////////////////////////////////////////////////////////////////////////////////////////
		
		// 기본값으로 초기화
		int nums[] = new int[2];
		System.out.println(nums[0] + ", " + nums[1]);	// 결과 : 0, 0
		
		double[] doubles = new double[2];
		System.out.println(doubles[0] + ", " + doubles[1]); // 결과 : 0.0, 0.0
		
		boolean bools[] = new boolean[2];
		System.out.println(bools[0] + " And " + bools[1]);  // 결과 : false And false
		
		String strs[] = new String[2];
		System.out.println(strs[0] + ", " + strs[1]);	// 결과 : null, null
		
		
		
		/////////////////////////////////////////////////////////////////////
		System.out.println("----------------------요소 접근 및 수정");
		
		// 요소 접근
		int[] scores = {50, 80, 90};
		System.out.println( scores[0] );  // 첫번째 요소 접근 => 결과 : 50
		
		// 요소 수정
		scores[0] = 70;
		System.out.println( scores[0] );	// 결과 : 70
		
		//////////////////////////////////////////////////////////////////////
		
		System.out.println("잘못된 인덱스 접근");
		
		// 잘못된 인덱스로 접근
		//System.out.println(scores[5]);
		/*
		결과 : ArrayIndexOutOfBoundsException 발생
		Exception in thread "main" java.lang.ArrayIndexOutOfBoundsException: Index 5 out of bounds for length 3
				at com.test01.studyArray.main(studyArray.java:57)
		 */
		
		////////////////////////////////////////////////////////////
		System.out.println("배열 길이");
		
		// 배열의 길이
		int size[] = new int[10];
		System.out.println(size.length); 	// 결과 : 10	=> 배열의 크기!
		
		////////////////////////////////////////////////////////////////////////////////
		
		System.out.println("반복문");
		
		// 반복문에서 배열
		String colors[] = {"Red", "Yellow", "Green"};
		
		// 1. for문
		for(int i=0; i<colors.length; i++) {
			System.out.print("["+i+": "+colors[i]+"] ");	// 결과 : [0: Red] [1: Yellow] [2: Green] 
		}
		System.out.println();		
		
		// 2. 향상된 for 문
		for(String color : colors) {
			System.out.print("["+color+"] ");	// 결과 : [Red] [Yellow] [Green] 
		}
		
		/////////////////////////////////////////////////////////////////////////////////
		System.out.println("다차원 배열");
		
		// 2차원 배열
		int[][] mathScores = {
			    {85, 90, 95},   // 1반
			    {78, 82, 88},   // 2반
			    {92, 89, 84}    // 3반
			};
		for(int i=0; i<mathScores.length; i++) {
			System.out.print((i+1)+"반 학생들의 점수 : ");
			for(int j=0; j<mathScores[i].length; j++) {		// 결과
				System.out.print(mathScores[i][j]+" ");		// 1반 학생들의 점수 : 85 90 95 
			}												// 2반 학생들의 점수 : 78 82 88 
			System.out.println();							// 3반 학생들의 점수 : 92 89 84 
		}

		// 가변 2차원 배열
		int[][] mutable = new int[3][];
		mutable[0] = new int[3];
		mutable[1] = new int[5];
		mutable[2] = new int[7];				// 결과 : 3, 5, 7
		System.out.println(mutable[0].length + ", " + mutable[1].length + ", " + mutable[2].length);
		
		
		System.out.println("배열 크기 변경");
		
		// Arrays.copyOf()
		int[] ori = {5, 10, 15};
		int[] newArr = Arrays.copyOf(ori, 5);
		for(int i=0; i<newArr.length; i++) {
			System.out.print("[" + i + ": " + newArr[i] + "] ");
		}
	}

}
