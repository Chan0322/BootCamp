package com.study;

import java.util.ArrayList;
import java.util.List;

public class garbage {
	
	public static void main(String[] args) {
		for(int i=0; i<1000000; i++) {
			String tmp = "num"+i;	// 임시 객체 
		}
		// tmp는 매 반복마다 새로 생성되고 기존 참조 사라짐
		// => 대부분이 Young 영역의 GC 대상임.
	}

}


