<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
  <display-name>Jsp05_HelloServlet</display-name>
  <welcome-file-list>
    <welcome-file>home.html</welcome-file> <!-- 자신의 프로젝트의 웰컴파일이름에 맞춰서 -->
  </welcome-file-list>
  <!-- 웹 어플리케이션 실행 시 가장 먼저 보여줄 페이지를 정의, 시작페이지 -->
  
  <!-- 어플리케이션 전체의 전역 파라미터 설정 /    파라미터: name과 value로 이뤄짐 -->
  <context-param>
  	<param-name>url</param-name>
  	<param-value>localhost:8787/Jsp04_LoginBoard</param-value>
  </context-param>
  
  <!-- 서블릿 등록 -->
  <servlet>
  	<servlet-name>helloServlet</servlet-name>	<!-- 이러한 이름으로 -->
  	<servlet-class>com.hello.controller.HelloController</servlet-class> <!--  이 클래스를 서블릿으로 등록한다. -->
  </servlet>
  <!-- 서블릿 연결 (url)-->
  <servlet-mapping>
  	<servlet-name>helloServlet</servlet-name> <!-- 해당 이름의 서블릿이 처리를 한다. -->
  	<url-pattern>/hello</url-pattern>	<!-- 이러한 요청이 들어오면. -->
  </servlet-mapping>
  <!-- 
  	/hello 라는 요청이 클라이언트로 부터 들어오게 되면 ws가 관리하는 내용 중에서 mapping 처리된
  	HelloController 서블릿이 동작한다.
  -->
  
  <servlet>
  	<servlet-name>byeServlet</servlet-name>
  	<servlet-class>com.bye.controller.ByeController</servlet-class>
  </servlet>
  <servlet-mapping>
  	<servlet-name>byeServlet</servlet-name>
  	<url-pattern>/bye</url-pattern>
  </servlet-mapping>
</web-app>