<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mlp.board">
	<select id="selectAll" resultType="BoardDto">
		SELECT *
		FROM MLPFEED
	</select>
	
	<insert id="insert">
		INSERT INTO MLPFEED
		VALUES(SEQ_MLPFEED.NEXTVAL, #{feedtitle}, #{feedcontent}, #{memno}, #{memgroup}, #{memdepart}, #{memname}, SYSDATE)
	</insert>
	
	<select id="selectOne" resultType="BoardDto">
		SELECT * FROM MLPFEED
		WHERE FEEDNO=#{feedno}
	</select>
</mapper>