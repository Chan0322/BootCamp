<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mlp.board">
	<select id="selectAll" parameterType="String" resultType="BoardDto">
		SELECT *
		FROM MLPFEED
		<choose>
			<when test="_parameter == 'oldest'">
				ORDER BY REGDATE ASC
			</when>
			<when test="_parameter == 'titlesort'">
				ORDER BY FEEDTITLE ASC
			</when>
			<otherwise>
				ORDER BY REGDATE DESC
			</otherwise>
		</choose>
	</select>
	
	<insert id="insert">
		INSERT INTO MLPFEED
		VALUES(SEQ_MLPFEED.NEXTVAL, #{feedtitle}, #{feedcontent}, #{memno}, #{memgroup}, #{memdepart}, #{memname}, SYSDATE)
	</insert>
	
	<select id="selectOne" resultType="BoardDto">
		SELECT * FROM MLPFEED
		WHERE FEEDNO=#{feedno}
	</select>
	
	<update id="update">
		UPDATE MLPFEED
		SET FEEDTITLE=#{feedtitle}, FEEDCONTENT=#{feedcontent}
		WHERE FEEDNO=#{feedno}
	</update>
	
	<delete id="delete">
		DELETE FROM MLPFEED
		WHERE FEEDNO=#{feedno}
	</delete>
</mapper>