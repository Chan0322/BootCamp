package com.lcpk.mtype;

import com.lcpk.mtype.service.RedisTestService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.CommandLineRunner;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;

@SpringBootApplication
public class MtypeApplication implements CommandLineRunner {

    @Autowired
    private RedisTestService redisTestService;

    public static void main(String[] args) {
        SpringApplication.run(MtypeApplication.class, args);
    }

    @Override
    public void run(String... args) throws Exception {
        // 앱 시작 시 Redis 연결 테스트
        redisTestService.testConnection();
    }
}








