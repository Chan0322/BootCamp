<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<h1>UPDATE</h1>
	<form th:action="@{/myboard/update}" method="post" th:object="${dto}">
		<input type="hidden" th:field="*{myno}">
		<table>
			<tr>
				<th>Myname</th>
				<td th:text="*{myname}"></td>
			</tr>
			<tr>
				<th>Mytitle</th>
				<td><input type="text" th:field="*{mytitle}"></td>
			</tr>
			<tr>
				<th>Mycontent</th>
				<td><textarea rows="10" cols="40" th:field="*{mycontent}"></textarea></td>
			</tr>
			<tr>
				<td colspan="2" align="right">
					<input type="submit" value="수정">
				</td>
			</tr>
		</table>
	</form>

</body>
</html>